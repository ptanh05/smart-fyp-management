# =====================================================================
# SMART FYP MANAGEMENT SYSTEM — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Institution: University of Transport and Communications (UTC)
# =====================================================================

# ---------------------------------------------------------------------
# FRONTEND (Vercel Project Settings -> Environment Variables)
# ---------------------------------------------------------------------
# Base URL pointing to the deployed Django backend API (e.g. Render / Railway / VPS)
VITE_API_BASE_URL=https://smart-fyp-backend.onrender.com/app

# Optional WebSocket Host and Port (or full WSS URL) for real-time chat/notifications
VITE_WS_URL=wss://smart-fyp-backend.onrender.com/ws
# VITE_WS_HOST=smart-fyp-backend.onrender.com
# VITE_WS_PORT=443

# ---------------------------------------------------------------------
# BACKEND (Render / Railway / VPS Environment Variables)
# ---------------------------------------------------------------------
# Django Security
SECRET_KEY=your_production_secure_secret_key_min_64_characters
DEBUG=False
ALLOWED_HOSTS=smart-fyp-backend.onrender.com,fyp.utc.edu.vn,localhost,127.0.0.1

# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgres://user:password@ep-cool-host.neon.tech/smart_fyp?sslmode=require

# CORS & CSRF Origins (Vercel Frontend domain)
CORS_ALLOWED_ORIGINS=https://smart-fyp-management.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://smart-fyp-management.vercel.app,http://localhost:3000

# Redis Connection (for Django Channels WebSocket layer)
REDIS_URL=redis://default:password@redis-host.render.com:6379

# Email SMTP Settings (UTC Notification System)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=utc.notification@utc.edu.vn
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@utc.edu.vn

# SSL & Security Headers
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
