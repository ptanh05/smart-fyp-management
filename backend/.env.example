# =====================================================================
# SMART FYP MANAGEMENT SYSTEM — BACKEND ENVIRONMENT VARIABLES TEMPLATE
# Institution: University of Transport and Communications (UTC)
# =====================================================================

# Django Security
SECRET_KEY=your_production_secure_secret_key_min_64_characters
DEBUG=False
ALLOWED_HOSTS=smart-fyp-backend.onrender.com,fyp.utc.edu.vn,localhost,127.0.0.1

# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgres://user:password@ep-cool-host.neon.tech/smart_fyp?sslmode=require

# CORS & CSRF Origins (Vercel Frontend domain)
CORS_ALLOWED_ORIGINS=https://smart-fyp-management.vercel.app,http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://smart-fyp-management.vercel.app,http://localhost:3000,http://localhost:5173

# Redis Connection (for Django Channels WebSocket layer & Cache)
REDIS_URL=redis://default:password@redis-host.render.com:6379

# Email SMTP Settings (UTC Notification System)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=utc.notification@utc.edu.vn
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@utc.edu.vn

# SSL & Security Headers
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ---------------------------------------------------------------------
# PERSISTENT MEDIA STORAGE (Cloudflare R2 / AWS S3)
# ---------------------------------------------------------------------
# Set USE_S3=True to persist file uploads across Render restarts/spin-downs
USE_S3=False
AWS_STORAGE_BUCKET_NAME=smart-fyp-media
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Cloudflare R2 Configuration (Recommended: Zero Egress Fees)
# AWS_S3_ENDPOINT_URL=https://<cloudflare_account_id>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto

# AWS S3 Configuration (Alternative)
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=ap-southeast-1

AWS_LOCATION=media
AWS_QUERYSTRING_AUTH=False

# ---------------------------------------------------------------------
# BACKGROUND TASKS & SINGLE SIGN-ON
# ---------------------------------------------------------------------
# Celery Task Queue
CELERY_BROKER_URL=redis://default:password@redis-host:6379/0
CELERY_RESULT_BACKEND=redis://default:password@redis-host:6379/0

# UTC Single Sign-On (Google OAuth2 for @utc.edu.vn)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
ALLOWED_SSO_DOMAINS=utc.edu.vn,gmail.com
