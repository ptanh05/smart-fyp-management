# Django Core Settings
SECRET_KEY=utc-smart-fyp-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Production Database Settings (PostgreSQL / MySQL / SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/smart_fyp_utc

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email SMTP Settings (UTC Notification System)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=utc.notification@utc.edu.vn
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@utc.edu.vn