# Django REST Framework API Base URL
# - Development (with Vite dev proxy): /app
# - Production (Standalone backend):  https://smart-fyp-backend.onrender.com/app
VITE_API_BASE_URL=https://smart-fyp-backend.onrender.com/app

# WebSocket Server Configuration (Real-time chat & notifications)
# - Production WSS endpoint:
VITE_WS_URL=wss://smart-fyp-backend.onrender.com/ws
# Or individual host/port:
# VITE_WS_HOST=smart-fyp-backend.onrender.com
# VITE_WS_PORT=443
